# Application
APP_NAME=RealOpen-AI
DEBUG=false

# Hardware Profile (auto-detected by setup.sh from profiles.yml)
# Options:
#   CPU-only (Windows/Linux, no GPU):  cpu_small, cpu_medium
#   NVIDIA GPU (CUDA):                 nvidia_small, nvidia_medium, nvidia_large, nvidia_xlarge
#   Apple Silicon (Metal/MLX):         apple_small, apple_medium, apple_large, apple_xlarge
# Models are defined in profiles.yml — edit that file to change models
HARDWARE_PROFILE=apple_medium

# Database
DATABASE_URL=postgresql+asyncpg://realopen:realopen@postgres:5432/realopen

# Ollama (native on host)
# macOS Docker Desktop uses host.docker.internal
# Linux Docker uses host-gateway (configured in docker-compose)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# SearxNG
SEARXNG_BASE_URL=http://searxng:8080

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (dev mode origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Modules — comma-separated list of enabled module names
# Required modules (assistant) are always enabled regardless of this setting.
# Optional modules: image_generation
# Only modules available for your hardware profile can be enabled.
ENABLED_MODULES=assistant

# Ngrok (optional remote access)
NGROK_ENABLED=false
NGROK_AUTHTOKEN=

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Setup mode — set to true to show the web setup wizard on first run.
# Auto-detected: if data/.setup-complete marker is missing, setup mode activates.
# SETUP_MODE=false

# ── Voice chat (runtime behavior only — ASR/TTS model selection lives in
# profiles.yml's top-level `voice:` section, the single source of truth) ──
# Master switch for the voice feature. When false, /ws/voice refuses
# sessions; text chat is unaffected.
VOICE_ENABLED=true
# Docker calls a native host process so macOS can use MLX/Metal and Linux or
# Windows can use their native accelerator runtime.
VOICE_RUNTIME_URL=http://host.docker.internal:8766
# Input audio format (mic + far-end AEC reference) — fixed by protocol v1.
VOICE_SAMPLE_RATE=16000
# TTS output audio format — fixed by protocol v1.
VOICE_TTS_SAMPLE_RATE=24000
# WebRTC VAD aggressiveness 0 (loose) .. 3 (aggressive).
VOICE_VAD_MODE=3
# Sustained voice-like audio required to open an utterance (rejects clicks).
VOICE_VAD_START_MS=240
# Silence (ms) after speech before the utterance is finalized.
VOICE_VAD_SILENCE_MS=1400
# Mic pre-roll (ms) kept before the VAD trigger (barge-in first syllables).
VOICE_PREROLL_MS=400
# AEC backend: auto | nlms | webrtc | none
VOICE_AEC=auto
# Sentence TTS chunker tuning: min chars before timeout flush / max chars
# before immediate flush / flush timeout (ms).
VOICE_TTS_MIN_CHARS=40
VOICE_TTS_MAX_CHARS=280
VOICE_TTS_FLUSH_MS=1500
# Hard cap on a single user utterance (seconds).
VOICE_MAX_UTTERANCE_SEC=30
# Idle timeout for a voice WebSocket session (seconds).
VOICE_SESSION_IDLE_SEC=600
