#!/usr/bin/env python3
import argparse,json,os
WORKSPACE="/workspace"
IGNORED={".git",".venv","venv",".pytest_cache","__pycache__","node_modules","dist","build"}
def walk(path,depth):
    if depth<0:return []
    try:
        entries=sorted(os.scandir(path),key=lambda e:(not e.is_dir(follow_symlinks=False),e.name.lower()))
    except OSError:return []
    result=[]
    for e in entries:
        if e.name in IGNORED:continue
        d=e.is_dir(follow_symlinks=False)
        item={"name":e.name,"path":e.path,"type":"directory" if d else "file"}
        if d:item["children"]=walk(e.path,depth-1)
        else:
            try:item["size"]=e.stat(follow_symlinks=False).st_size
            except OSError:pass
        result.append(item)
    return result
def main():
    p=argparse.ArgumentParser()
    p.add_argument("path",nargs="?",default=WORKSPACE)
    p.add_argument("--depth",type=int,default=4)
    a=p.parse_args()
    root=os.path.realpath(a.path)
    if root!=WORKSPACE and not root.startswith(WORKSPACE+"/"):raise SystemExit("outside workspace")
    print(json.dumps(walk(root,a.depth)))
if __name__=="__main__":main()