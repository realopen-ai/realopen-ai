#!/usr/bin/env python3
import argparse, json, os
p=argparse.ArgumentParser(); p.add_argument("path", nargs="?", default="/workspace"); p.add_argument("--depth", type=int, default=4); a=p.parse_args()
root=os.path.realpath(a.path)
if root != "/workspace" and not root.startswith("/workspace/"): raise SystemExit("outside workspace")
ignored={".git", ".venv", "venv", ".pytest_cache", "__pycache__", "node_modules", "dist", "build"}
def walk(path, depth):
    out=[]
    if depth < 0: return out
    try: names=sorted(os.listdir(path), key=lambda n:(not os.path.isdir(os.path.join(path,n)),n.lower()))
    except OSError: return out
    for name in names:
        if name in ignored: continue
        full=os.path.join(path,name); item={"name":name,"path":full,"type":"directory" if os.path.isdir(full) else "file"}
        if item["type"] == "directory": item["children"]=walk(full,depth-1)
        else:
            try: item["size"]=os.path.getsize(full)
            except OSError: pass
        out.append(item)
    return out
print(json.dumps(walk(root,a.depth)))
