# Native overrides. Copy to .env.native only when customization is needed.
# Precedence: process environment > .env.native > .env > native defaults.
# Original Docker service URLs in .env are translated to native defaults.
# Default PostgreSQL/Valkey ports are 55432/56379 to avoid existing installations.
# Custom URLs are external by default: RealOpen never starts/stops their services.
# DATABASE_URL=postgresql+asyncpg://user:password@192.168.1.10:5432/realopen
# REDIS_URL=redis://192.168.1.10:6379/0
# SEARXNG_BASE_URL=http://192.168.1.10:8080
# DEGOOG_BASE_URL=https://search.example.org
# OLLAMA_BASE_URL=http://192.168.1.10:11434
# Override auto-detection, e.g. an existing service at a default local endpoint:
# NATIVE_DATABASE_MODE=external
# NATIVE_REDIS_MODE=external
# NATIVE_SEARXNG_MODE=external
# NATIVE_DEGOOG_MODE=external
# NATIVE_OLLAMA_MODE=external
# NATIVE_VOICE_RUNTIME_MODE=external
# NATIVE_API_PORT=8000
# NATIVE_FRONTEND_PORT=5173
# NATIVE_PG_BIN=/path/to/postgresql/17/bin
# NATIVE_PYTHON=/path/to/existing/backend/venv/bin/python
# Optional: persist a DeGoog settings password (never commit .env.native).
# DEGOOG_SETTINGS_PASSWORDS=choose-a-password
