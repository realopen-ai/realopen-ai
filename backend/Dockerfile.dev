FROM python:3.12-slim

WORKDIR /app

ENV HF_HOME=/app/data/huggingface \
    REALOPEN_DATA_DIR=/app/data \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=10

# Runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
    fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip install --no-cache-dir poetry

# No virtualenv - install into system python
RUN poetry config virtualenvs.create false

# Copy dependency files first (layer caching)
COPY pyproject.toml poetry.lock* ./

# Install dependencies (including dev)
RUN poetry install --no-interaction --no-ansi --no-root

# Application code is mounted via volume in docker-compose.dev.yml
# But copy defaults for when volume is not used
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./

RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN mkdir -p /opt/optional

EXPOSE 8000

# Hot reload via uvicorn --reload. Voice sessions use an application-level
# heartbeat, so keep uvicorn's transport ping from expiring during inference.
CMD ["sh", "-c", "alembic upgrade head && cd /app/app && PYTHONPATH=/app uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir . --ws-ping-interval 3600 --ws-ping-timeout 3600"]
