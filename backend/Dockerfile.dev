FROM python:3.12-slim

WORKDIR /app

# Runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip install --no-cache-dir poetry

# No virtualenv - install into system python
RUN poetry config virtualenvs.create false

# Copy dependency files first (layer caching)
COPY pyproject.toml poetry.lock* ./

# Install dependencies (including dev)
RUN poetry install --no-interaction --no-ansi --no-root

# Application code is mounted via volume in docker-compose.dev.yml
# But copy defaults for when volume is not used
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./

# ── Optional dependency overlay ──────────────────────────────────────
# /opt/optional is a Docker volume. Optional deps are extracted here
# so they survive container rebuilds without re-downloading.
RUN mkdir -p /opt/optional

ENV PATH="/opt/optional/usr/bin:/opt/optional/usr/sbin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/optional/usr/lib/x86_64-linux-gnu:/opt/optional/usr/lib:/opt/optional/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH}"
ENV PYTHONPATH="/opt/optional/usr/lib/python3/dist-packages:${PYTHONPATH}"

EXPOSE 8000

# Hot reload via uvicorn --reload
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/app"]